.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.env
!.env.example
data/
*.sqlite3
*.sqlite3-journal
.DS_Store
# Real biometric captures must never be committed. Synthetic only in fixtures/.
fixtures/*real*.json
fixtures/*session*.json
!fixtures/synthetic-*.json
# Heavy reproducible artifacts: rendered frames, review stills, Cap projects,
# and node_modules stay local. The shipped Whoop take is allow-listed below.
demo/animated/frames/
demo/animated/review/
demo/animated/node_modules/
demo/*.cap/
# All recorded takes stay local; the submission links the uploaded video.
demo/take-*.mp4
# Ring-themed animated explainer: portfolio-only, not part of submission.
demo/animated/
# Final demo cut (rendered by daebak carousels/unchained-demo) stays local.
demo/unchained-demo-*.mp4
